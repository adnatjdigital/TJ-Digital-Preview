  /* Credentials strip, quiet: one row of text, small blue dots, one soft hairline */
  .trust { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px 32px; padding-block: 22px clamp(44px, 5vw, 72px); border-top: 1px solid var(--line); }
  .trust li, .trust li:nth-child(n) { position: static; display: flex; align-items: center; gap: 10px; padding: 0; border: 0; }
  .trust li::before, .trust li + li::before, .trust li:nth-child(odd)::before { content: ''; display: block; position: static; flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
  .cred { display: inline; font-size: 15px; line-height: 1.5; color: var(--gray); }
  .cred strong { font-weight: 600; color: var(--ink); }
  .cred-link { text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; color: var(--ink); padding-bottom: 2px; transition: background-size .5s var(--ease); }
  .cred-link:hover { background-size: 100% 1px; }
  @media (max-width: 1180px) {
    .trust { flex-direction: column; align-items: flex-start; gap: 14px; }
    .trust li, .trust li:nth-child(n) { align-items: baseline; }
    .trust li::before, .trust li + li::before, .trust li:nth-child(odd)::before { transform: translateY(-2px); }
  }
  /* Orange palette: contrast-safe uses.
     #eb864c fills, bars, lines and text on dark; #d9702f large type on light; #b9561c small text on light. */
  a, .text-link { color: var(--accent-ink); }
  .text-link.light, .panel .text-link, .panel a.text-link { color: var(--peach); }
  .letter .text-link { color: var(--accent-ink); }
  .eyebrow { color: var(--accent-ink); }
  .panel .eyebrow { color: var(--peach); }
  .h1-line.acc { color: var(--accent-deep); }
  .nav-pill a:hover, .nav-pill a[aria-current] { color: var(--accent-ink); }
  .faq-n, .pod-show, .faq-item:hover .faq-q, .pod:hover .pod-ep, .cell-plain .cell-price { color: var(--accent-ink); }
  .quote-mark { color: var(--accent); }
  .btn-accent, .btn-accent:hover, .panel .btn-accent:hover { color: var(--ink); }
  .btn-accent:hover, .panel .btn-accent:hover { background: var(--blue-hover); }
  .btn-accent .btn-icon { color: var(--accent-ink); }
  .btn-ghost .btn-icon { color: var(--accent-ink); }
  .btn-ghost:hover { border-color: var(--accent); }
  .d-atext mark { color: var(--ink); }
  .step.on .step-dot { color: var(--ink); }
  .d-flow, .tick, .chk { color: var(--ink); }
  /* Orange cards: dark text on the orange gradient */
  .cell-blue, .cell-blue h3 { color: var(--ink); }
  .cell-blue .cell-text { color: #3b2a1f; }
  .cell-blue .cell-price { color: #3b2a1f; }
  .plan-lines path { stroke: rgba(26, 26, 26, 0.35); }
  .plan-trend path { stroke: var(--ink); }
  .case-lead .case-figure, .case-lead .case-metric, .case-lead .val { color: var(--ink); }
  .case-lead .bar-after .fill { background: var(--ink); }
  .case-lead .bar-before .fill { background: rgba(26, 26, 26, 0.3); }
  .case-lead .track { background: rgba(26, 26, 26, 0.12); }
  .case-lead .case-foot { border-color: rgba(26, 26, 26, 0.18); }
  :focus-visible { outline-color: var(--accent-deep); }
  .panel :focus-visible { outline-color: var(--peach); }
  .panel .letter .text-link { color: var(--accent-ink); }
  @media (min-width: 1181px) {
    .trust { display: grid; grid-template-columns: repeat(4, auto); justify-content: space-between; column-gap: 28px; }
  }
  @media (min-width: 1360px) {
    .trust { column-gap: 24px; }
    .cred { white-space: nowrap; font-size: 14px; }
  }
  /* Deeper burnt-orange cards with white text (AA: white on #b9561c 4.77:1, on #8f3f10 7.27:1) */
  .cell-blue, .case-lead { background: radial-gradient(120% 120% at 0% 0%, #b9561c 0%, #a84a15 55%, #8f3f10 100%); }
  .cell-blue, .cell-blue h3, .cell-blue .cell-text, .cell-blue .cell-price { color: #fff; }
  .plan-lines path { stroke: rgba(255, 255, 255, 0.6); }
  .plan-trend path { stroke: #fff; }
  .case-lead .case-kind, .case-lead .case-figure, .case-lead .case-metric, .case-lead .val, .case-lead .bar dt, .case-lead .case-foot { color: #fff; }
  .case-lead .bar-after .fill { background: #fff; }
  .case-lead .bar-before .fill { background: rgba(255, 255, 255, 0.45); }
  .case-lead .track { background: rgba(255, 255, 255, 0.18); }
  .case-lead .case-foot { border-color: rgba(255, 255, 255, 0.25); }

  /* Mouse light: smaller and fainter everywhere */
  /* No numbers in the FAQ */
  .faq-item summary { grid-template-columns: 1fr auto; }
  .faq-a { padding-left: 0; }
  /* Results, restructured: context first, four identical cards, then two quiet notes */
  .res-head { display: grid; gap: 18px; max-width: 760px; margin-bottom: clamp(36px, 4vw, 56px); }
  .res-head .lead { max-width: 60ch; }
  .rc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .rc {
    display: flex; flex-direction: column; gap: 12px; padding: clamp(22px, 1.8vw, 30px); border-radius: 22px;
    background: rgba(255, 255, 255, 0.04); border: 1px solid var(--glass-line);
    transition: transform .5s var(--ease), border-color .3s, background .3s;
  }
  .rc:hover, .js .rc[data-reveal].in:hover { transform: translateY(-4px); border-color: rgba(255, 188, 125, 0.4); background: rgba(255, 255, 255, 0.06); }
  .rc-kind { font-family: var(--display); font-size: 17px; font-weight: 650; letter-spacing: -0.01em; color: #fff; }
  .rc-metric { color: var(--on-dark-muted); font-size: 15px; line-height: 1.45; flex: 1; }
  .rc-fig { display: flex; align-items: flex-start; gap: 12px; margin-top: 10px; white-space: nowrap; }
  .rc-b, .rc-a { display: grid; gap: 4px; }
  .rc-num { font-family: var(--display); font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .rc-b .rc-num { font-size: clamp(17px, 1.3vw, 22px); color: var(--on-dark-muted); padding-top: .55em; }
  .rc-a .rc-num { font-size: clamp(30px, 2.5vw, 48px); color: var(--accent); }
  .rc-l { font-size: 12px; color: var(--on-dark-muted); }
  .rc-arrow { flex-shrink: 0; margin-top: .9em; color: var(--on-dark-muted); }
  .rc-foot { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--glass-line); font-size: 12px; color: var(--on-dark-muted); }
  .rc-also { display: grid; grid-template-columns: 1fr 1fr; gap: 24px clamp(24px, 4vw, 64px); margin-top: clamp(36px, 4vw, 56px); }
  .rc-also li { display: grid; gap: 6px; }
  .rc-also-kind { font-family: var(--display); font-weight: 650; color: #fff; }
  .rc-also-kind span { margin-left: 10px; font-family: 'Inter Variable', sans-serif; font-size: 13px; font-weight: 500; color: var(--on-dark-muted); }
  .rc-also-text { color: var(--on-dark-muted); font-size: 15px; max-width: 56ch; }
  @media (max-width: 1180px) { .rc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .rc-grid, .rc-also { grid-template-columns: 1fr; } }
  .rc-fig { align-items: flex-end; }
  .rc-b .rc-num { padding-top: 0; }
  .rc-arrow { margin: 0 0 1.75em; }
  /* Results as an editorial list: hairline rows, no boxes */
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .rl { border-top: 1px solid rgba(229, 225, 220, 0.16); }
  .rl-row {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(260px, auto); gap: 16px clamp(24px, 3vw, 56px);
    align-items: center; padding: 30px 0; border-bottom: 1px solid rgba(229, 225, 220, 0.16);
  }
  .rl-row::before { content: ''; position: absolute; left: 0; top: 50%; width: 12px; height: 2px; margin-top: -1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease); }
  .rl-who { display: grid; gap: 6px; transition: translate .4s var(--ease); }
  .rl-kind { font-family: var(--display); font-size: clamp(17px, 1.3vw, 20px); font-weight: 600; letter-spacing: -0.01em; color: #fff; }
  .rl-meta { display: flex; flex-wrap: wrap; gap: 2px 12px; font-size: 13px; color: var(--on-dark-muted); }
  .rl-metric, .rl-story { color: var(--on-dark-muted); font-size: 15px; line-height: 1.5; max-width: 44ch; }
  .rl-story { grid-column: 2 / -1; max-width: 62ch; }
  .rl-fig { justify-self: end; display: flex; align-items: baseline; gap: 14px; white-space: nowrap; }
  .rl-b { font-family: var(--display); font-size: clamp(17px, 1.3vw, 21px); font-weight: 600; letter-spacing: -0.02em; color: var(--on-dark-muted); }
  .rl-arrow { align-self: center; color: var(--on-dark-muted); }
  .rl-a { font-family: var(--display); font-size: clamp(36px, 3.2vw, 58px); font-weight: 700; letter-spacing: -0.045em; line-height: 1; color: var(--accent); }
  @media (hover: hover) {
    .rl-row:hover::before { transform: scaleX(1); }
    .rl-row:hover .rl-who { translate: 22px 0; }
  }
  @media (max-width: 1180px) {
    .rl-row { grid-template-columns: minmax(0, 1fr) auto; }
    .rl-metric { grid-row: 2; grid-column: 1 / -1; }
    .rl-fig { grid-row: 1; grid-column: 2; }
    .rl-story { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .rl-row { grid-template-columns: 1fr; gap: 10px; padding: 24px 0; }
    .rl-metric, .rl-fig, .rl-story { grid-row: auto; grid-column: 1; }
    .rl-fig { justify-self: start; margin-top: 4px; }
    .rl-a { font-size: 40px; }
  }
  @media (min-width: 1181px) { .rl-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) clamp(280px, 22vw, 400px); } }
  @media (min-width: 761px) and (max-width: 1180px) { .rl-row { grid-template-columns: minmax(0, 1fr) 260px; } }
  /* No rounded corners anywhere, including pseudo-elements and focus outlines */
  *, *::before, *::after { border-radius: 0 !important; }
  /* Working with us: scroll-linked steps */
  .rail-fill { transition: none; }
  .js .step .step-card { opacity: 1; translate: 0 0; }
  .step h4 { color: #5f5a55; transition: color .4s var(--ease); }
  .step.on h4 { color: #1a1a1a; }
  .step .step-card p:not(.step-when) { transition: transform .5s var(--ease), opacity .5s var(--ease); }
  .step:not(.on) .step-card p:not(.step-when) { transform: translateX(14px); opacity: .85; }
  .step { transition: translate .35s var(--ease); }
  .step:hover { translate: 6px 0; }
  .step:hover .step-dot { scale: 1.1; }
  @keyframes stepPulse { 0% { box-shadow: 0 0 0 6px #fbfaf8, 0 0 0 6px rgba(235, 134, 76, 0.55); } 100% { box-shadow: 0 0 0 6px #fbfaf8, 0 0 0 18px rgba(235, 134, 76, 0); } }
  .step.pulse .step-dot { animation: stepPulse .7s var(--ease); }
  @media (prefers-reduced-motion: reduce) { .step:hover { translate: none; } .step:not(.on) .step-card p { transform: none; opacity: 1; } }
  .panel.working { overflow: clip; }
  /* ===== Section rhythm: white, dark, white, orange, off-white, dark, white, orange, dark ===== */
  .services, .faq { background: #ffffff; }
  .pods { background: #fbfaf8; border-block: 1px solid #e5e1dc; }

  /* Results: orange */
  .results {
    --on-dark: #1a1a1a; --on-dark-muted: #2a1d14; --glass-line: rgba(26, 26, 26, 0.2); --tint: #1a1a1a; --peach: #1a1a1a;
    background: #eb864c; color: #1a1a1a;
  }
  .results h2 { color: #1a1a1a; }
  .results .lead { color: #2a1d14; }
  .results .rl { border-top-color: rgba(26, 26, 26, 0.22); }
  .results .rl-row { border-bottom-color: rgba(26, 26, 26, 0.22); }
  .results .rl-row::before { background: #1a1a1a; }
  .results .rl-kind, .results .rl-a { color: #1a1a1a; }
  .results .rl-meta, .results .rl-metric, .results .rl-story { color: #2a1d14; }
  .results .rl-b, .results .rl-arrow { color: #3b2a1f; }
  .results :focus-visible { outline-color: #1a1a1a; }

  /* Working with us: dark, orange rail and markers */
  .working .step h4 { color: #c9c2bb; }
  .working .step.on h4 { color: #ffffff; }
  .working .step:hover h4 { color: #ffbc7d; }
  .working .step-when { color: #ffbc7d; }
  .working .step p { color: #c9c2bb; }
  .working .step-dot { background: #24211e; border-color: rgba(255, 255, 255, 0.14); color: #c9c2bb; box-shadow: 0 0 0 6px #161514; }
  .working .step.on .step-dot { background: #eb864c; border-color: #eb864c; color: #1a1a1a; }
  .working .rail { background: rgba(255, 255, 255, 0.14); }
  .working .rail-fill { background: linear-gradient(180deg, #ffbc7d, #eb864c); }
  @keyframes stepPulseDark { 0% { box-shadow: 0 0 0 6px #161514, 0 0 0 6px rgba(235, 134, 76, 0.6); } 100% { box-shadow: 0 0 0 6px #161514, 0 0 0 18px rgba(235, 134, 76, 0); } }
  .working .step.pulse .step-dot { animation: stepPulseDark .7s var(--ease); }
  /* Contact: photo band (from the light version), sharp corners */
  .cband { position: relative; overflow: hidden; isolation: isolate; margin-top: 12px; padding: clamp(96px, 11vw, 190px) var(--gut); color: #ffffff; text-align: center; }
  .cband-photo { position: absolute; inset: -60px 0; z-index: -2; }
  .cband-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .cband::before { content: ""; position: absolute; inset: 0; z-index: -1; background: rgba(20, 18, 16, 0.74); }
  .cband-inner { display: grid; gap: 26px; justify-items: center; max-width: 820px; margin-inline: auto; }
  .cband h2 { color: #ffffff; font-size: clamp(42px, 5.4vw, 100px); line-height: 1; letter-spacing: -0.055em; }
  .cband .lead { color: #e6dfd8; max-width: 50ch; margin-inline: auto; }
  .cband .btn-row, .cband .pills { justify-content: center; }
  .cband .mail-link { color: #ffffff; }
  .cband .pill { color: #e6dfd8; }
  .cband .pill svg { color: #ffbc7d; }
  .cband .pill:hover { color: #ffffff; }
  .cband :focus-visible { outline-color: #ffbc7d; }
  @media (max-width: 760px) { .cband { padding: 80px 22px; } }
  /* ===== Results: dark, calm, report-style ===== */
  .results { background: #161514; color: #ffffff; border: 0; }
  .results h2 { color: #ffffff; }
  .results .lead { color: #c9c2bb; font-size: clamp(17px, 1.2vw, 20px); }
  .results .res-head { margin-bottom: clamp(48px, 5vw, 88px); }
  .rx { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .rx-cell { display: grid; gap: 14px; align-content: start; padding: clamp(32px, 3.4vw, 56px) clamp(0px, 3vw, 56px) clamp(32px, 3.4vw, 56px) 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .rx-cell:nth-child(even) { padding-left: clamp(24px, 3vw, 56px); padding-right: 0; border-left: 1px solid rgba(255, 255, 255, 0.1); }
  .rx-kind { font-family: var(--display); font-size: 18px; font-weight: 500; color: #ffffff; letter-spacing: -0.01em; }
  .rx-num { font-family: var(--display); font-size: clamp(64px, 7vw, 132px); font-weight: 300; line-height: .95; letter-spacing: -0.05em; color: #eb864c; white-space: nowrap; font-variant-numeric: tabular-nums; margin-top: 6px; }
  .rx-metric { font-size: 18px; line-height: 1.45; color: #edeae6; max-width: 34ch; }
  .rx-meta { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 6px; font-size: 14px; color: #b5aea7; }
  .rx-also { display: grid; grid-template-columns: 1fr 1fr; gap: 0 clamp(24px, 3vw, 56px); margin-top: clamp(40px, 4vw, 64px); }
  .rx-also li { display: grid; gap: 8px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .rx-also-kind { font-family: var(--display); font-size: 18px; font-weight: 500; color: #ffffff; }
  .rx-also-kind time { margin-left: 10px; font-family: 'Inter Variable', sans-serif; font-size: 14px; font-weight: 400; color: #b5aea7; }
  .rx-also-text { font-size: 17px; color: #c9c2bb; max-width: 56ch; }
  @media (prefers-reduced-motion: no-preference) {
    .js .rx-cell[data-reveal], .js .rx-also li[data-reveal] { transition-duration: .6s; }
    .js .rx-cell[data-reveal] { background: linear-gradient(rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.1)) 0 100% / 0 1px no-repeat; }
    .js .rx-cell[data-reveal].in { background-size: 100% 1px; transition: opacity .6s var(--ease), translate .6s var(--ease), background-size 1.2s var(--ease) .2s; }
  }
  @media (max-width: 760px) {
    .rx, .rx-also { grid-template-columns: 1fr; }
    .rx-cell, .rx-cell:nth-child(even) { padding: 32px 0; border-left: 0; }
    .rx-num { font-size: clamp(52px, 16vw, 72px); }
  }

  /* ===== Full width: content runs close to the edges ===== */
  :root { --gut: clamp(20px, 3vw, 56px); }
  .page { padding: 0; }
  .panel, .sec, .cband, .hero { margin-left: 0; margin-right: 0; }
  .lead, .hero-lead, .demo-copy p, .cell-text, .rx-metric, .rx-also-text, .faq-a, .step p, .peec-text { max-width: 68ch; }

  /* ===== Buttons: one consistent, sharp system ===== */
  .btn, .btn-lg, .top-actions .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 52px; min-height: 52px; padding: 0 28px;
    font-size: 16px; font-weight: 600; letter-spacing: 0.01em; line-height: 1; white-space: nowrap; text-decoration: none;
    border: 1px solid transparent; box-shadow: none; background-image: none; transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .btn-accent, .btn-accent:hover, .panel .btn-accent:hover { box-shadow: none; }
  .btn-accent { background: #eb864c; color: #1a1a1a; }
  .btn-accent:hover, .panel .btn-accent:hover { background: #f29a63; color: #1a1a1a; }
  .btn-ghost { background: transparent; color: #1a1a1a; border-color: #1a1a1a; }
